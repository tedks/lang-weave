{
  "manifest_version": 3,
  "name": "Lang Weave",
  "version": "0.12.6",
  "key": "",
  "description": "Learn languages through the English you already read: contextual words, hover hints and click-to-English.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/content-loader.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/catalog.js",
        "src/content.js",
        "src/events.js",
        "src/hash.js",
        "src/language-name.js",
        "src/learning.js",
        "src/levels.js",
        "src/page.js",
        "src/personal-capture.js",
        "src/personal.js",
        "src/review.js",
        "src/semantic.js",
        "src/settings.js",
        "src/text.js",
        "src/vocabulary.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Lang Weave",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
