package(default_visibility = ["//visibility:private"])

filegroup(
    name = "version_scan_inputs",
    srcs = glob(["*.mjs"]),
    visibility = ["//extension:__pkg__"],
)

filegroup(
    name = "packager",
    srcs = [
        "content-bundle.mjs",
        "package.mjs",
    ],
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "suite_scripts",
    srcs = [
        "icons.mjs",
        "messages.mjs",
        ":packager",
    ],
    visibility = ["//:__pkg__"],
)
