sh_test(
    name = "inherited_python_test",
    srcs = ["//build_defs:run_inherited_python_test.sh"],
    data = glob(
        [
            ".claude-plugin/*.json",
            "blocks/level-*.md",
            "commands/*.md",
            "data/**/*.csv",
            "scripts/*.py",
            "tests/**/*.py",
        ],
        exclude = ["tests/model_eval.py"],
    ) + glob(
        ["tests/fixtures/**"],
        allow_empty = True,
    ) + [
        "MODULE.bazel",
        "//extension:version_scan_inputs",
    ],
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_binary(
    name = "release_version_check",
    srcs = ["//build_defs:run_release_version_check.sh"],
    args = ["$(rlocationpath :tests/check_version_bump.py)"],
    data = ["tests/check_version_bump.py"],
)

# The proxy imports extension modules in place. Keep the existing payload
# visibility and expose its runfiles only to the proxy test package.
alias(
    name = "proxy_extension_runfiles",
    actual = "//extension:payload",
    visibility = ["//proxy:__pkg__"],
)
